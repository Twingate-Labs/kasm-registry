{
  "description": "Google Chrome with Twingate Zero-Trust Network Access.",
  "docker_registry": "https://us-docker.pkg.dev/twingate-prod/agentless/",
  "image_src": "twingate-chrome.svg",
  "name": "us-docker.pkg.dev/twingate-prod/agentless/tg-chrome:dev",
  "run_config": {
    "cap_add": [
      "NET_ADMIN"
    ],
    "devices": [
      "/dev/net/tun:/dev/net/tun:rwm"
    ],
    "hostname": "kasm"
  },
  "exec_config": {
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    },
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Browser"
  ],
  "friendly_name": "Twingate Chrome",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    "1.13.x",
    "1.14.x",
    "1.15.x"
  ],
  "uncompressed_size_mb": 2170,
  "notes": "For setup instructions please refer to Twingate documentation at https://[TODO]"
}